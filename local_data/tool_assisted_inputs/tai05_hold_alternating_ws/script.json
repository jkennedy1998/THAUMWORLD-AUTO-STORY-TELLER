{
  "id": "movement_hold_alternating_ws",
  "test_name": "walk_test_hold_alternating_ws",
  "open_ms": 32000,
  "description": "Alternate long W and S holds on stable ground to trace held movement cadence, fast-path delivery, and duplicate batch behavior.",
  "start_delay_ms": 2500,
  "end_delay_ms": 3000,
  "boot": {
    "auto_connect": true,
    "auto_claim": true,
    "actor_ref": "actor.ent_pah43wtpah"
  },
  "actions": [
    { "at_breath": 0, "type": "assert_context_ready" },
    { "at_breath": 1, "type": "capture_actor_tile", "slot": "start_tile" },
    { "at_breath": 2, "type": "marker", "label": "start" },

    { "at_breath": 4, "type": "key_down", "code": "KeyW", "key": "w" },
    { "at_breath": 10, "type": "capture_movement_trace", "slot": "trace_w_1a" },
    { "at_breath": 10, "type": "assert_movement_trace_ready", "min_input_seq": 1, "require_direction": true, "require_gate": "ok" },
    { "at_breath": 18, "type": "capture_movement_trace", "slot": "trace_w_1b" },
    { "at_breath": 20, "type": "key_up", "code": "KeyW", "key": "w" },

    { "at_breath": 24, "type": "key_down", "code": "KeyS", "key": "s" },
    { "at_breath": 30, "type": "capture_movement_trace", "slot": "trace_s_1a" },
    { "at_breath": 30, "type": "assert_movement_trace_ready", "min_input_seq": 3, "require_direction": true, "require_gate": "ok" },
    { "at_breath": 40, "type": "capture_movement_trace", "slot": "trace_s_1b" },
    { "at_breath": 44, "type": "key_up", "code": "KeyS", "key": "s" },

    { "at_breath": 50, "type": "key_down", "code": "KeyW", "key": "w" },
    { "at_breath": 58, "type": "capture_movement_trace", "slot": "trace_w_2a" },
    { "at_breath": 68, "type": "capture_movement_trace", "slot": "trace_w_2b" },
    { "at_breath": 74, "type": "key_up", "code": "KeyW", "key": "w" },

    { "at_breath": 80, "type": "key_down", "code": "KeyS", "key": "s" },
    { "at_breath": 90, "type": "capture_movement_trace", "slot": "trace_s_2a" },
    { "at_breath": 102, "type": "capture_movement_trace", "slot": "trace_s_2b" },
    { "at_breath": 108, "type": "key_up", "code": "KeyS", "key": "s" },

    { "at_breath": 114, "type": "key_down", "code": "KeyW", "key": "w" },
    { "at_breath": 124, "type": "capture_movement_trace", "slot": "trace_w_3a" },
    { "at_breath": 134, "type": "capture_movement_trace", "slot": "trace_w_3b" },
    { "at_breath": 138, "type": "key_up", "code": "KeyW", "key": "w" },

    { "at_breath": 142, "type": "capture_actor_tile", "slot": "end_tile" },
    { "at_breath": 142, "type": "assert_actor_tile_changed", "slot": "start_tile" },
    { "at_breath": 143, "type": "marker", "label": "end" }
  ]
}
