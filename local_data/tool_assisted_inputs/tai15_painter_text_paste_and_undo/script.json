{
  "id": "painter_text_paste_and_undo",
  "test_name": "paint_test_text_tool_paste_chunk_and_undo",
  "clock_mode": "realtime_ms",
  "open_ms": 9000,
  "description": "Paste a multi-line text chunk into painter text mode, verify both lines land, then undo the chunk with Ctrl+Z.",
  "start_delay_ms": 2200,
  "end_delay_ms": 1000,
  "actions": [
    { "at_ms": 20, "type": "invoke_helper", "helper": "clear_painter_cells", "payload": { "cells": [ { "x": 23, "y": 19, "z": 0 }, { "x": 23, "y": 20, "z": 0 } ] } },
    { "at_ms": 50, "type": "pointer_move", "space": "grid", "x": 60, "y": 24, "pointer_action": "primary" },
    { "at_ms": 80, "type": "capture_painter_interaction_anchor", "slot": "anchor_start" },
    { "at_ms": 120, "type": "pointer_move", "space": "grid", "x": 60, "y": 25, "pointer_action": "primary" },
    { "at_ms": 150, "type": "capture_painter_interaction_anchor", "slot": "anchor_next_line" },
    { "at_ms": 260, "type": "key_tap", "code": "KeyT", "key": "t", "hold_ms": 30 },
    { "at_ms": 460, "type": "pointer_click", "space": "grid", "x": 60, "y": 24, "pointer_action": "primary" },
    { "at_ms": 650, "type": "capture_painter_anchor_cell", "slot": "start_before", "anchor_slot": "anchor_start" },
    { "at_ms": 670, "type": "capture_painter_anchor_cell", "slot": "next_before", "anchor_slot": "anchor_next_line" },
    { "at_ms": 900, "type": "text_input", "text": "PA\nST" },
    { "at_ms": 1450, "type": "assert_painter_anchor_cell_changed", "slot": "start_before", "anchor_slot": "anchor_start" },
    { "at_ms": 1490, "type": "assert_painter_anchor_cell_changed", "slot": "next_before", "anchor_slot": "anchor_next_line" },
    { "at_ms": 1750, "type": "key_tap", "code": "Escape", "key": "Escape", "hold_ms": 30 },
    { "at_ms": 2250, "type": "key_tap", "code": "KeyZ", "key": "z", "ctrl": true, "hold_ms": 30 },
    { "at_ms": 2950, "type": "assert_painter_anchor_cell_equals", "slot": "start_before", "anchor_slot": "anchor_start" },
    { "at_ms": 2990, "type": "assert_painter_anchor_cell_equals", "slot": "next_before", "anchor_slot": "anchor_next_line" }
  ]
}
