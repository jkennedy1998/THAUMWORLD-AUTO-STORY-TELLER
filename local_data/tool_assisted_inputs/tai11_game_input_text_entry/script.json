{
  "id": "game_input_text_entry",
  "test_name": "game_test_input_module_text_entry_and_backspace",
  "clock_mode": "breath",
  "open_ms": 18000,
  "description": "Focus the communication input, type text through standard text input, then verify backspace updates the draft.",
  "start_delay_ms": 2500,
  "end_delay_ms": 2500,
  "boot": {
    "auto_connect": true,
    "auto_claim": true,
    "actor_ref": "actor.ent_ZPHB7TZ3AV"
  },
  "actions": [
    { "at_breath": 0, "type": "assert_context_ready" },
    { "at_breath": 1, "type": "invoke_helper", "helper": "set_communication_input_draft", "payload": { "value": "" } },
    { "at_breath": 2, "type": "capture_text_value", "slot": "draft_before", "source": "communication_input" },
    { "at_breath": 3, "type": "pointer_click", "space": "grid", "x": 10, "y": 3, "pointer_action": "primary" },
    { "at_breath": 4, "type": "text_input", "text": "PING" },
    { "at_breath": 5, "type": "key_tap", "code": "Backspace", "key": "Backspace", "hold_ms": 30 },
    { "at_breath": 7, "type": "assert_text_value_changed", "slot": "draft_before", "source": "communication_input" },
    { "at_breath": 8, "type": "assert_text_value_literal", "source": "communication_input", "value": "PIN" }
  ]
}
