{
  "id": "painter_multiplayer_patch_smoke",
  "test_name": "paint_test_multiplayer_patch_kinds_group_commands",
  "clock_mode": "realtime_ms",
  "open_ms": 20000,
  "description": "Verify authoritative-host painter patch metadata changes across group structural commands and group undo-redo.",
  "start_delay_ms": 1800,
  "end_delay_ms": 1500,
  "actions": [
    { "at_ms": 0, "type": "invoke_helper", "helper": "reset_painter_document" },
    { "at_ms": 280, "type": "capture_text_value", "slot": "patch_rev_before", "source": "runtime_value", "field": "last_patch_revision" },
    { "at_ms": 320, "type": "capture_text_value", "slot": "patch_kind_before", "source": "runtime_value", "field": "last_patch_command_kind" },
    { "at_ms": 360, "type": "invoke_helper", "helper": "add_group" },
    { "at_ms": 900, "type": "assert_text_value_changed", "slot": "patch_rev_before", "source": "runtime_value", "field": "last_patch_revision" },
    { "at_ms": 980, "type": "assert_text_value_changed", "slot": "patch_kind_before", "source": "runtime_value", "field": "last_patch_command_kind" },
    { "at_ms": 1060, "type": "capture_text_value", "slot": "patch_kind_after_add", "source": "runtime_value", "field": "last_patch_command_kind" },
    { "at_ms": 1140, "type": "capture_text_value", "slot": "patch_rev_after_add", "source": "runtime_value", "field": "last_patch_revision" },

    { "at_ms": 1500, "type": "invoke_helper", "helper": "duplicate_active_group" },
    { "at_ms": 2400, "type": "assert_text_value_changed", "slot": "patch_kind_after_add", "source": "runtime_value", "field": "last_patch_command_kind" },
    { "at_ms": 2480, "type": "assert_text_value_changed", "slot": "patch_rev_after_add", "source": "runtime_value", "field": "last_patch_revision" },
    { "at_ms": 2560, "type": "capture_text_value", "slot": "patch_kind_after_duplicate", "source": "runtime_value", "field": "last_patch_command_kind" },

    { "at_ms": 2920, "type": "invoke_helper", "helper": "reverse_group_order" },
    { "at_ms": 3820, "type": "assert_text_value_changed", "slot": "patch_kind_after_duplicate", "source": "runtime_value", "field": "last_patch_command_kind" },
    { "at_ms": 3960, "type": "pointer_move", "space": "grid", "x": 60, "y": 24, "pointer_action": "primary" },
    { "at_ms": 4040, "type": "capture_painter_interaction_anchor", "slot": "anchor_before_draw" },
    { "at_ms": 4160, "type": "invoke_helper", "helper": "clear_anchor_cell" },
    { "at_ms": 4500, "type": "key_tap", "code": "KeyP", "key": "p", "hold_ms": 30 },
    { "at_ms": 4920, "type": "pointer_drag", "space": "grid", "from_x": 60, "from_y": 24, "to_x": 63, "to_y": 24, "steps": 3, "pointer_action": "primary" },
    { "at_ms": 5700, "type": "capture_text_value", "slot": "patch_kind_after_draw", "source": "runtime_value", "field": "last_patch_command_kind" },

    { "at_ms": 6200, "type": "invoke_helper", "helper": "undo_painter" },
    { "at_ms": 7000, "type": "assert_text_value_changed", "slot": "patch_kind_after_draw", "source": "runtime_value", "field": "last_patch_command_kind" },
    { "at_ms": 7080, "type": "capture_text_value", "slot": "patch_kind_after_undo", "source": "runtime_value", "field": "last_patch_command_kind" },

    { "at_ms": 7560, "type": "invoke_helper", "helper": "redo_painter" },
    { "at_ms": 8360, "type": "assert_text_value_changed", "slot": "patch_kind_after_undo", "source": "runtime_value", "field": "last_patch_command_kind" }
  ]
}
