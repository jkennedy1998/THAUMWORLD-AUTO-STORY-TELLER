{
  "id": "painter_group_workflow",
  "test_name": "paint_test_group_add_duplicate_reorder_draw_undo",
  "clock_mode": "realtime_ms",
  "open_ms": 14000,
  "description": "Boot the painter into a new painting, add and duplicate groups, reverse their order, draw into the active group, and verify undo/redo stays stable.",
  "start_delay_ms": 1800,
  "end_delay_ms": 1000,
  "actions": [
    { "at_ms": 0, "type": "invoke_helper", "helper": "reset_painter_document" },
    { "at_ms": 250, "type": "capture_text_value", "slot": "group_count_before", "source": "runtime_value", "field": "group_count" },
    { "at_ms": 300, "type": "capture_text_value", "slot": "group_order_before", "source": "runtime_value", "field": "group_order" },
    { "at_ms": 500, "type": "invoke_helper", "helper": "add_group" },
    { "at_ms": 800, "type": "invoke_helper", "helper": "duplicate_active_group" },
    { "at_ms": 1200, "type": "invoke_helper", "helper": "reverse_group_order" },
    { "at_ms": 1700, "type": "assert_text_value_changed", "slot": "group_count_before", "source": "runtime_value", "field": "group_count" },
    { "at_ms": 1750, "type": "assert_text_value_changed", "slot": "group_order_before", "source": "runtime_value", "field": "group_order" },
    { "at_ms": 1950, "type": "pointer_move", "space": "grid", "x": 60, "y": 24, "pointer_action": "primary" },
    { "at_ms": 2100, "type": "capture_painter_interaction_anchor", "slot": "anchor_before_draw" },
    { "at_ms": 2300, "type": "invoke_helper", "helper": "clear_anchor_cell" },
    { "at_ms": 2600, "type": "capture_text_value", "slot": "history_after_clear", "source": "runtime_value", "field": "active_group_history_index" },
    { "at_ms": 2900, "type": "key_tap", "code": "KeyP", "key": "p", "hold_ms": 30 },
    { "at_ms": 3300, "type": "pointer_drag", "space": "grid", "from_x": 60, "from_y": 24, "to_x": 63, "to_y": 24, "steps": 3, "pointer_action": "primary" },
    { "at_ms": 3900, "type": "capture_text_value", "slot": "history_after_draw", "source": "runtime_value", "field": "active_group_history_index" },
    { "at_ms": 3950, "type": "assert_text_value_changed", "slot": "history_after_clear", "source": "runtime_value", "field": "active_group_history_index" },
    { "at_ms": 4300, "type": "invoke_helper", "helper": "undo_painter" },
    { "at_ms": 4900, "type": "assert_text_value_literal", "source": "runtime_value", "field": "active_group_history_index", "value": "3" },
    { "at_ms": 5300, "type": "invoke_helper", "helper": "redo_painter" },
    { "at_ms": 5900, "type": "assert_text_value_equals", "slot": "history_after_draw", "source": "runtime_value", "field": "active_group_history_index" }
  ]
}
