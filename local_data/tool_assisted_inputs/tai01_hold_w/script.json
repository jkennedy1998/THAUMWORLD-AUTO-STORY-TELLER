{
  "id": "movement_hold_w_latency",
  "test_name": "walk_test_hold_w_latency",
  "clock_mode": "breath",
  "open_ms": 18000,
  "description": "Hold W, verify the movement pipeline populates latency diagnostics, and confirm at least one legal visible move lands within budget.",
  "start_delay_ms": 2500,
  "end_delay_ms": 3000,
  "boot": {
    "auto_connect": true,
    "auto_claim": true,
    "actor_ref": "actor.ent_ZPHB7TZ3AV"
  },
  "actions": [
    { "at_breath": 0, "type": "assert_context_ready" },
    { "at_breath": 1, "type": "capture_actor_tile", "slot": "start_tile" },
    { "at_breath": 2, "type": "marker", "label": "start_capture" },
    { "at_breath": 4, "type": "key_down", "code": "KeyW", "key": "w" },
    { "at_breath": 12, "type": "capture_movement_trace", "slot": "trace_mid_hold" },
    { "at_breath": 12, "type": "assert_movement_trace_ready", "min_input_seq": 1, "require_direction": true, "require_gate": "ok" },
    { "at_breath": 16, "type": "capture_actor_tile", "slot": "after_hold_tile" },
    { "at_breath": 16, "type": "assert_actor_tile_changed", "slot": "start_tile" },
    { "at_breath": 16, "type": "capture_visible_step", "slot": "visible_after_hold" },
    { "at_breath": 16, "type": "capture_movement_trace", "slot": "trace_after_hold" },
    { "at_breath": 16, "type": "assert_movement_trace_ready", "min_input_seq": 1, "require_stage": "moved", "require_direction": true, "require_gate": "ok", "max_input_to_visible_ms": 900, "max_accept_to_visible_ms": 700 },
    { "at_breath": 18, "type": "key_up", "code": "KeyW", "key": "w" },
    { "at_breath": 21, "type": "capture_movement_trace", "slot": "trace_after_release" },
    { "at_breath": 22, "type": "marker", "label": "hold_complete" }
  ]
}
