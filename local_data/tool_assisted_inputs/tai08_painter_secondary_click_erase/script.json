{
  "id": "painter_secondary_click_erase",
  "test_name": "paint_test_secondary_click_eraser_clears_cell",
  "clock_mode": "realtime_ms",
  "open_ms": 7000,
  "start_delay_ms": 1200,
  "end_delay_ms": 1000,
  "actions": [
    { "at_ms": 0, "type": "capture_painter_camera_target", "slot": "camera_target_start" },
    { "at_ms": 0, "type": "capture_painter_bounds", "slot": "bounds_start" },
    { "at_ms": 0, "type": "pointer_move", "space": "grid", "x": 60, "y": 24, "pointer_action": "primary" },
    { "at_ms": 50, "type": "capture_painter_interaction_anchor", "slot": "anchor_target" },
    { "at_ms": 0, "type": "key_tap", "code": "KeyP", "key": "p", "hold_ms": 30 },
    { "at_ms": 450, "type": "assert_painter_primary_tool", "tool": "pencil" },
    { "at_ms": 470, "type": "assert_painter_anchor_in_bounds", "anchor_slot": "anchor_target" },
    { "at_ms": 650, "type": "capture_painter_anchor_cell", "slot": "cell_before_draw", "anchor_slot": "anchor_target" },
    { "at_ms": 850, "type": "pointer_click", "space": "grid", "x": 60, "y": 24, "pointer_action": "primary" },
    { "at_ms": 1150, "type": "capture_painter_anchor_cell", "slot": "cell_after_draw", "anchor_slot": "anchor_target" },
    { "at_ms": 1170, "type": "assert_painter_anchor_cell_changed", "slot": "cell_before_draw", "anchor_slot": "anchor_target" },
    { "at_ms": 1400, "type": "key_tap", "code": "KeyE", "key": "e", "hold_ms": 30 },
    { "at_ms": 1540, "type": "key_tap", "code": "KeyE", "key": "e", "hold_ms": 30 },
    { "at_ms": 1900, "type": "assert_painter_secondary_tool", "tool": "eraser" },
    { "at_ms": 2100, "type": "pointer_click", "space": "grid", "x": 60, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 2400, "type": "capture_painter_anchor_cell", "slot": "cell_after_erase", "anchor_slot": "anchor_target" },
    { "at_ms": 2420, "type": "assert_painter_anchor_cell_changed", "slot": "cell_after_draw", "anchor_slot": "anchor_target" }
  ]
}
