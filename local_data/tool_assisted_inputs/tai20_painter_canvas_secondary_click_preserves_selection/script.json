{
  "id": "painter_canvas_secondary_click_preserves_selection",
  "test_name": "paint_test_canvas_secondary_click_preserves_selected_group",
  "clock_mode": "realtime_ms",
  "open_ms": 9000,
  "description": "Create three painter groups, select a non-default group, then secondary-click the canvas and verify the active painter group does not snap back to layer 1.",
  "start_delay_ms": 1500,
  "end_delay_ms": 1000,
  "actions": [
    { "at_ms": 0, "type": "invoke_helper", "helper": "reset_painter_document" },
    { "at_ms": 250, "type": "invoke_helper", "helper": "add_group" },
    { "at_ms": 500, "type": "invoke_helper", "helper": "add_group" },
    { "at_ms": 900, "type": "invoke_helper", "helper": "reset_painter_module_layout" },
    { "at_ms": 1200, "type": "invoke_helper", "helper": "select_group_by_palette_z", "payload": { "z": 2 } },
    { "at_ms": 1500, "type": "capture_text_value", "slot": "active_group_before_secondary", "source": "runtime_value", "field": "active_group_id" },
    { "at_ms": 1550, "type": "capture_text_value", "slot": "active_palette_z_before_secondary", "source": "runtime_value", "field": "active_group_palette_z" },
    { "at_ms": 1800, "type": "pointer_move", "space": "grid", "x": 60, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 1950, "type": "pointer_click", "space": "grid", "x": 60, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 2350, "type": "assert_text_value_equals", "slot": "active_group_before_secondary", "source": "runtime_value", "field": "active_group_id" },
    { "at_ms": 2400, "type": "assert_text_value_equals", "slot": "active_palette_z_before_secondary", "source": "runtime_value", "field": "active_group_palette_z" }
  ]
}
