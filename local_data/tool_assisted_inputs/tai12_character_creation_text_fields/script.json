{
  "id": "character_creation_text_fields",
  "test_name": "game_test_character_creation_name_and_title_text_fields",
  "clock_mode": "breath",
  "open_ms": 22000,
  "description": "Open character creation, type into the name field, navigate with arrows, and type into the title field.",
  "start_delay_ms": 2500,
  "end_delay_ms": 2500,
  "boot": {
    "auto_connect": true,
    "auto_claim": true,
    "actor_ref": "actor.ent_ZPHB7TZ3AV"
  },
  "actions": [
    { "at_breath": 0, "type": "assert_context_ready" },
    { "at_breath": 1, "type": "invoke_helper", "helper": "open_character_creation" },
    { "at_breath": 6, "type": "pointer_click", "space": "grid", "x": 76, "y": 23, "pointer_action": "primary" },
    { "at_breath": 7, "type": "text_input", "text": "ALFA" },
    { "at_breath": 8, "type": "key_tap", "code": "ArrowUp", "key": "ArrowUp", "hold_ms": 30 },
    { "at_breath": 9, "type": "text_input", "text": "CAPT" },
    { "at_breath": 11, "type": "assert_text_value_literal", "source": "character_creation", "field": "name", "value": "ALFA" },
    { "at_breath": 12, "type": "assert_text_value_literal", "source": "character_creation", "field": "title", "value": "CAPT" },
    { "at_breath": 13, "type": "invoke_helper", "helper": "close_character_creation" }
  ]
}
