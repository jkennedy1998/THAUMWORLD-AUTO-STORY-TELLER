{
  "id": "painter_secondary_drag_nav_depth_preserves_selection",
  "test_name": "paint_test_secondary_drag_nav_depth_preserves_selected_group",
  "clock_mode": "realtime_ms",
  "open_ms": 10500,
  "description": "Select a non-default painter group, begin a secondary drag on canvas, step depth with the navigation panel button, and verify focus depth changes without snapping the active group selection.",
  "start_delay_ms": 1500,
  "end_delay_ms": 1000,
  "actions": [
    { "at_ms": 0, "type": "invoke_helper", "helper": "reset_painter_document" },
    { "at_ms": 250, "type": "invoke_helper", "helper": "add_group" },
    { "at_ms": 500, "type": "invoke_helper", "helper": "add_group" },
    { "at_ms": 900, "type": "invoke_helper", "helper": "reset_painter_module_layout" },
    { "at_ms": 1200, "type": "invoke_helper", "helper": "select_group_by_palette_z", "payload": { "z": 2 } },
    { "at_ms": 1500, "type": "capture_text_value", "slot": "active_group_before_drag", "source": "runtime_value", "field": "active_group_id" },
    { "at_ms": 1550, "type": "capture_text_value", "slot": "active_palette_z_before_drag", "source": "runtime_value", "field": "active_group_palette_z" },
    { "at_ms": 1600, "type": "capture_text_value", "slot": "focus_plane_before_drag", "source": "runtime_value", "field": "focus_plane" },
    { "at_ms": 1750, "type": "pointer_move", "space": "grid", "x": 60, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 1900, "type": "pointer_down", "space": "grid", "x": 60, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 2200, "type": "pointer_click", "space": "grid", "x": 118, "y": 31, "pointer_action": "primary" },
    { "at_ms": 2500, "type": "assert_text_value_changed", "slot": "focus_plane_before_drag", "source": "runtime_value", "field": "focus_plane" },
    { "at_ms": 2650, "type": "pointer_move", "space": "grid", "x": 66, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 2900, "type": "pointer_up", "space": "grid", "x": 66, "y": 24, "pointer_action": "secondary" },
    { "at_ms": 3250, "type": "assert_text_value_equals", "slot": "active_group_before_drag", "source": "runtime_value", "field": "active_group_id" },
    { "at_ms": 3300, "type": "assert_text_value_equals", "slot": "active_palette_z_before_drag", "source": "runtime_value", "field": "active_group_palette_z" }
  ]
}
