      "mag": 1,
      "meta": [],
      "scope": ["TILE"]
    },
    {
      "name": "OCCUPIES",
      "mag": 1,
      "meta": [],
      "scope": ["TILE"]
    },
    {
      "name": "CONTAINER",
      "mag": 1,
      "meta": [],
